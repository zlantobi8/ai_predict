# Copy this file to .env and fill in your real values. Never commit .env.

# MySQL / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=predictive_maintenance_db

# JWT (login tokens) — use a long random string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=12

# Only needed if you run a SEPARATE front end (e.g. React on :3000) against this API.
# The built-in pages are served by this app itself and don't need CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FLASK_DEBUG=1
